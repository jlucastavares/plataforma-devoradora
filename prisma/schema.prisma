datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Tabela de Usuários/Sócios
model User {
  id           String        @id @default(cuid())
  name         String?
  email        String?       @unique
  password     String? // Adicionamos para salvar a senha
  cpf          String?       @unique // CPF único para cada sócio
  course       String? // Curso do aluno
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  subscription Subscription?
}

// Tabela de Assinaturas (Sistema de Sócios)
model Subscription {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id])
  status    String    @default("INACTIVE") // ACTIVE, INACTIVE, PENDING
  pixCode   String? // QR Code do último pagamento
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tabela de Produtos (Loja)
model Product {
  id          String @id @default(cuid())
  name        String
  description String
  price       Float
  image       String
  category    String // Camisa, Caneca, Tirante...
  stock       Int    @default(0)

  createdAt DateTime @default(now())
}

// Tabela de Agenda (Jogos e Eventos)
model Event {
  id          String   @id @default(cuid())
  title       String
  description String
  date        DateTime
  location    String
  type        String // JOGO, FESTA, TREINO

  createdAt DateTime @default(now())
}

model Member {
  id        String   @id @default(cuid())
  name      String
  role      String // Ex: Presidência, Esportes, Comunicação...
  image     String? // URL da foto (opcional)
  order     Int      @default(0) // Para ordenar quem aparece primeiro
  createdAt DateTime @default(now())
}
